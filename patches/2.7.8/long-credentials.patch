diff -ruN a/src/openvpn/common.h b/src/openvpn/common.h
--- a/src/openvpn/common.h	2026-08-03 16:42:49.000000000 +0300
+++ b/src/openvpn/common.h	2026-08-28 14:07:54.136189840 +0300
@@ -67,7 +67,19 @@
  * maximum size of a single TLS message (cleartext).
  * This parameter must be >= PUSH_BUNDLE_SIZE
  */
-#define TLS_CHANNEL_BUF_SIZE 2048
+/* OpenP2S: the Microsoft Entra access token travels as the OpenVPN password
+ * inside the key-method-2 control message. That payload -- a ~2-3 KB JWT plus
+ * peer-info, OCC metadata and the other key-method-2 fields -- does not fit in
+ * the stock 2048-byte control channel, and the Azure gateway resets the
+ * session before authentication can complete.
+ *
+ * 8192 is the value proven to work against a live gateway. It is deliberately
+ * no larger: this buffer is allocated per TLS session, and the value should
+ * come back down if a smaller one is ever shown to be sufficient.
+ *
+ * Unconditional, because it only enlarges a buffer -- it changes nothing about
+ * what goes on the wire for a non-Azure peer. */
+#define TLS_CHANNEL_BUF_SIZE 8192
 
 /* TLS control buffer minimum size
  *
diff -ruN a/src/openvpn/misc.h b/src/openvpn/misc.h
--- a/src/openvpn/misc.h	2026-08-03 16:42:49.000000000 +0300
+++ b/src/openvpn/misc.h	2026-08-28 14:07:54.136123911 +0300
@@ -64,7 +64,18 @@
 #ifdef ENABLE_PKCS11
 #define USER_PASS_LEN 4096
 #else
-#define USER_PASS_LEN 128
+/* OpenP2S: with Entra authentication the access token *is* the OpenVPN
+ * password, and is roughly 2.3 KB. The stock 128-byte buffer truncates it to
+ * 127 characters, so the gateway receives a malformed credential and resets.
+ *
+ * 4096 matches the ENABLE_PKCS11 value directly above, so it is a size
+ * upstream already exercises. Note this is a *limit*, not a guarantee: openp2s
+ * checks the token length itself and fails with a clear message rather than
+ * letting a longer token be silently truncated here.
+ *
+ * The 128-byte limit is not really Azure-specific -- any OAuth/OIDC bearer
+ * credential runs into it -- and is a candidate for an upstream fix. */
+#define USER_PASS_LEN 4096
 #endif
     /* Note that username and password are expected to be null-terminated */
     char username[USER_PASS_LEN];
