+/*
+ * OpenP2S: check that the effective configuration really matches what the
+ * Azure OCC options string advertises.
+ *
+ * The hardcoded OCC string claims TCPv4_CLIENT, dev-type tun, AES-256-GCM,
+ * tls-auth and keydir 1. Sending it while actually running with different
+ * settings would mean lying to the peer about the connection parameters. That
+ * is both dishonest and a source of failures that are miserable to debug: the
+ * gateway would accept the handshake and the data channel would then not work.
+ * Refuse to start instead.
+ *
+ * Note on key direction: --key-direction 1 parses to KEY_DIRECTION_INVERSE,
+ * not KEY_DIRECTION_NORMAL. The config file number and the enum name do not
+ * line up, and getting this backwards rejects every valid Azure profile.
+ */
+static void
+options_postprocess_verify_azure_compat(const struct options *o)
+{
+    const int dev = dev_type_enum(o->dev, o->dev_type);
+    /* tls-auth may be set globally or inside a <connection> block. */
+    const bool has_tls_auth = (o->tls_auth_file != NULL) || (o->ce.tls_auth_file != NULL);
+    const int key_direction =
+        (o->ce.tls_auth_file != NULL) ? o->ce.key_direction : o->key_direction;
+
+    if (!o->tls_client)
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --client (or --tls-client)");
+    }
+    if (o->ce.proto != PROTO_TCP_CLIENT)
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --proto tcp-client: the Azure OCC "
+                     "options string advertises TCPv4_CLIENT");
+    }
+    if (dev != DEV_TYPE_TUN)
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --dev tun: the Azure OCC options "
+                     "string advertises dev-type tun");
+    }
+    if (!o->ciphername || !streq(o->ciphername, "AES-256-GCM"))
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --cipher AES-256-GCM: the Azure OCC "
+                     "options string advertises cipher AES-256-GCM");
+    }
+    if (!has_tls_auth)
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --tls-auth: the Azure OCC options "
+                     "string advertises tls-auth");
+    }
+    if (key_direction != KEY_DIRECTION_INVERSE)
+    {
+        msg(M_USAGE, "--experimental-azure-compat requires --key-direction 1: the Azure OCC "
+                     "options string advertises keydir 1");
+    }
+}
+
 static void
 options_postprocess_verify(const struct options *o)
 {
+    if (o->azure_compat)
+    {
+        options_postprocess_verify_azure_compat(o);
+    }
+
     if (o->connection_list)
     {
         int i;
@@ -4576,6 +4644,35 @@
 #undef TLS_CLIENT
 #undef TLS_SERVER
 
+    /* OpenP2S: Azure Point-to-Site OCC options string (--experimental-azure-compat).
+     *
+     * Some Azure Entra gateways appear to compare the client's OCC options
+     * string against what the Microsoft Azure VPN client sends, rather than
+     * against a string they derive themselves. The link-mtu/tun-mtu pair in it
+     * (1500/1551) is not something OpenVPN would compute, so the whole locally
+     * generated string is replaced rather than adjusted.
+     *
+     * Only the local (sent) string is overridden. `remote` is the string we
+     * expect to receive *from* the peer and is left exactly as upstream
+     * computed it, so OCC mismatch detection against the server still works.
+     *
+     * options_postprocess_verify_azure_compat() has established that the
+     * transport-visible parts - TCP client, tun, AES-256-GCM, tls-auth,
+     * keydir 1 - really are what this string advertises. The MTU fields are
+     * deliberately NOT checked and do not describe this connection: they are
+     * copied so the string matches what the gateway expects to see. That is
+     * why the option is gated and named experimental.
+     *
+     * The exact string comes from the reverse engineering documented by the
+     * cveld/azure-vpn-client-headless-container project. */
+    if (o->azure_compat && !remote)
+    {
+        buf_clear(&out);
+        buf_printf(&out,
+                   "V4,dev-type tun,link-mtu 1500,tun-mtu 1551,proto TCPv4_CLIENT,keydir 1,cipher "
+                   "AES-256-GCM,auth [null-digest],keysize 256,tls-auth,key-method 2,tls-client");
+    }
+
     return BSTR(&out);
 }
 
